#!/bin/bash
# Made-up GitHub answers for the repos widget: acme/app and acme/cli.
path=""; for a in "$@"; do case "$a" in repos/*) path=$a ;; esac; done
days() { local n=$1 i; printf '['; for i in 0 1 2 3 4 5 6; do [ $i -gt 0 ] && printf ','; printf '{"timestamp":"%sT00:00:00Z","count":%d,"uniques":%d}' "$(date -v-${i}d +%Y-%m-%d)" $((n / 7 + i)) $((n / 30 + 1)); done; printf ']'; }
case "$path" in
repos/acme/app) echo '{"stargazers_count":128,"forks_count":9,"private":false}' ;;
repos/acme/cli) echo '{"stargazers_count":41,"forks_count":3,"private":false}' ;;
repos/acme/app/releases*) echo '[{"tag_name":"v2.1.0","assets":[{"download_count":312},{"download_count":88}]},{"tag_name":"v2.0.0","assets":[{"download_count":540}]}]' ;;
repos/acme/cli/releases*) echo '[{"tag_name":"v0.9.2","assets":[{"download_count":61}]}]' ;;
repos/acme/app/traffic/views) printf '{"count":1240,"uniques":356,"views":%s}\n' "$(days 1240)" ;;
repos/acme/cli/traffic/views) printf '{"count":310,"uniques":74,"views":%s}\n' "$(days 310)" ;;
repos/acme/app/traffic/clones) echo '{"count":420,"uniques":160,"clones":[]}' ;;
repos/acme/cli/traffic/clones) echo '{"count":95,"uniques":40,"clones":[]}' ;;
repos/acme/app/traffic/popular/referrers) echo '[{"referrer":"news.ycombinator.com","count":510},{"referrer":"github.com","count":220},{"referrer":"reddit.com","count":96}]' ;;
repos/acme/cli/traffic/popular/referrers) echo '[{"referrer":"github.com","count":80}]' ;;
*) echo "gh: Not Found (HTTP 404)" >&2; exit 1 ;;
esac
